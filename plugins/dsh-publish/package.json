{
  "name": "dsh-plugin-publish",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 发布端插件：唯一发布入口、人工审批门禁、回执台账",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wzhmaggie25-rgb/laowang-workbench.git",
    "directory": "plugins/dsh-publish"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "tests",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "zod": "4.4.3"
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  }
}
